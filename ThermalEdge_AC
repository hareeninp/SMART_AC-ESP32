#include "cooling_verification.h"
#include "routes.h"

// ── Globals ───────────────────────────────────────────────────────────────────
PsychicHttpServer   server;
ACController        acController;
SensorManager       sensorManager;
AuthManager         authManager;
SchedulerManager    schedulerManager;
CoolingVerification coolingVerification;

// ── WiFi credential storage ───────────────────────────────────────────────────
static void loadWiFiCreds(String& ssid, String& pass) {
    Preferences p;
    p.begin("wifi", true);
    ssid = p.getString("ssid", WIFI_SSID);
    pass = p.getString("pass", WIFI_PASSWORD);
    p.end();
}

void saveWiFiCreds(const String& ssid, const String& pass) {
    Preferences p;
    p.begin("wifi", false);
    p.putString("ssid", ssid);
    p.putString("pass", pass);
    p.end();
    Serial.printf("[WiFi] Credentials saved (ssid=%s)\n", ssid.c_str());
}

// ── AP fallback ───────────────────────────────────────────────────────────────
static void startAP() {
    Serial.println(F("[WiFi] Starting AP fallback..."));
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_PASSWORD);
    Serial.print(F("[WiFi] AP IP: "));
    Serial.println(WiFi.softAPIP());
    Serial.printf("[WiFi] Connect to '%s' → http://192.168.4.1\n",
                  AP_SSID);
}

// ── Connect to STA WiFi with 60-second timeout; fall back to AP ──────────────
static bool connectWiFi(const String& ssid, const String& pass) {
    WiFi.mode(WIFI_STA);
    WiFi.begin(ssid.c_str(), pass.c_str());
    Serial.printf("[WiFi] Connecting to '%s'", ssid.c_str());
    uint32_t start = millis();
    while (WiFi.status() != WL_CONNECTED) {
        if (millis() - start > 60000UL) {
            Serial.println(F("\n[WiFi] 60 s timeout"));
            return false;
        }
        delay(500); Serial.print('.');
    }
    Serial.println();
    Serial.print(F("[WiFi] IP: ")); Serial.println(WiFi.localIP());
    return true;
}

// ── setup ─────────────────────────────────────────────────────────────────────
void setup() {
    Serial.begin(115200);
    delay(400);
    Serial.println(F("\n=== ThermalEdge AC – Phase 3 + Cooling Verification ===\n"));

    sensorManager.begin();
    acController.begin();

    schedulerManager.begin();
    authManager.begin();

    String wSSID, wPASS;
    loadWiFiCreds(wSSID, wPASS);

    bool staOk = connectWiFi(wSSID, wPASS);
    if (!staOk) {
        startAP();
    } else {
        schedulerManager.startNTP();
        if (MDNS.begin(MDNS_HOSTNAME))
            Serial.println(F("[mDNS] smartac.local ready"));
    }

    server.config.max_uri_handlers = 64;
    registerRoutes(server, acController, sensorManager,
                   authManager, schedulerManager, coolingVerification);
    server.begin();

    Serial.println(F("\n[Ready]"));
    if (staOk) {
        Serial.println(F("  http://smartac.local"));
        Serial.print(  F("  http://")); Serial.println(WiFi.localIP());
    } else {
        Serial.printf("  http://192.168.4.1  (AP mode – %s)\n", AP_SSID);
    }
    Serial.println(F("  Login credentials configured locally.\n"));
}

// ── loop ──────────────────────────────────────────────────────────────────────
void loop() {
    sensorManager.update();
    schedulerManager.tick(acController, coolingVerification);
    schedulerManager.tickTempMode(acController, sensorManager.getTemp(), coolingVerification);
    coolingVerification.tick(sensorManager, acController);
    // ===== Debug Commands =====
    if (Serial.available()) {
       String cmd = Serial.readStringUntil('\n');
       cmd.trim();

       if (cmd.equalsIgnoreCase("heap")) {
        Serial.println();
        Serial.println("========== HEAP ==========");
        Serial.printf("Free Heap        : %u bytes\n", ESP.getFreeHeap());
        Serial.printf("Largest Free Block: %u bytes\n", ESP.getMaxAllocHeap());
        Serial.printf("Minimum Free Heap : %u bytes\n", ESP.getMinFreeHeap());
        Serial.println("==========================");
        Serial.println();
    }
}
    delay(10);
}
